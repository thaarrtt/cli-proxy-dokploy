# ──────────────────────────────────────────────────────────────
# CLI Proxy API + Management Center — Dokploy environment config
# Copy this file to `.env` and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Ports ─────────────────────────────────────────────────────
# Port the CLI Proxy API backend listens on (host-side)
API_PORT=8317

# Port the Management UI Nginx server listens on (host-side)
UI_PORT=8080

# ── Backend: Management ────────────────────────────────────────
# The password/key used to authenticate to the management UI.
# Set a strong random value — this protects your entire proxy config.
MANAGEMENT_PASSWORD=change-me-to-a-strong-password

# Allow management API access from non-localhost origins.
# Set to "true" when Dokploy proxies requests from a different host.
# MANAGEMENT_ALLOW_REMOTE=true

# ── Frontend: UI version label (used in build arg) ────────────
UI_VERSION=latest
